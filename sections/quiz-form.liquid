<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vital Check Quiz</title>
    <style>
                  input[type='radio']:checked + span::before {
                  content: '✓';
                  color: white;
                  background: #007bff;
                  border-radius: 50%;
                  width: 20px;
                  height: 20px;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  position: absolute;
                  right: 5px;
                  }
                  body {
                  font-family: Arial, sans-serif;
                  background-color: #f5f5f5;
                  margin: 0;
                  padding: 0;
                  }
                  .quiz-container {
                  width: 70%;
                  background: white;
                  margin: 20px auto;
                  padding: 20px;
                  border-radius: 10px;
                  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
                  }
                  h2 {
                  text-align: center;
                  color: #333;
                  }
                  .quiz-container-heading-main {
                  border-bottom: 1px solid #ddd;
                  margin-bottom: 15px;
                  }
                  .question-item{
                      margin-bottom: 25px;

                  }
                  .question-item:last-child {
                  border-bottom: none;
                  }
                  .question-label {
                  font-size: 16px;
                  margin-bottom: 10px;
                  display: block;
                  font-weight: bold;
                  }
                  .options {
                  display: flex;
                  gap: 15px;
                  }
                  .option-label {
                  display: flex;
                  align-items: center;
                  gap: 5px;
                  padding: 10px;
                  border: 1px solid #dbdbdb;
                  border-radius: 5px;
                  cursor: pointer;
                  position: relative;
                  width: 364px;
                  }
                  input[type='radio'] {
                  display: none;
                  }
                  input[type='radio']:checked + span {
                  border-radius: 5px;
                  }
                  .navigation {
                  display: flex;
                  justify-content: space-between;
                  margin-top: 20px;
                  }
                  button {
                  padding: 10px 20px;
                  border: none;
                  background: #007bff;
                  color: white;
                  cursor: pointer;
                  border-radius: 5px;
                  }
                  button:disabled {
                  background: #ccc;
                  cursor: not-allowed;
                  }
                  .submit-section {
                  text-align: center;
                  margin: auto;
                  margin-top: 20px;
                  width: 70%;
                  display: flex;
                  align-items: center;
                  flex-direction:column;

                  }
                  .submit-section #submit-btn{
                  width: 100%;
                  }
                  .outer-form p , .submit-50-quest-note{
                  color: #BD3D44;
                  }
                  .outer-form {
                  width: 70%;
                  margin: auto;
                  display: flex;
                  flex-direction: row;
                  justify-content: space-between;
                  padding-top: 20px;
                  }
                  .quiz-container-heading {
                  max-width: 469px;
                  font-size: 20px;
                  font-weight: 400;
                  text-align: left;
                  }
                  .submit-50-quest-note {
                  max-width: 680px;
                  }

              {% comment %} Thank you page  {% endcomment %}

                  .thankyou-container {

                  display:none;
                  width: 80%;
                  margin: auto;
                  margin-top: 20px;
                  margin-bottom: 20px;
                  background: white;
                  border: 1px solid #EEEEEE;
                  border-radius: 10px;
                  padding: 30px;
                  text-align: center;
                  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
                  }
                  .thankyou-container .icon {
                  font-size: 40px;
                  color: #2ecc71;
                  }
                  .thankyou-container h2 {
                  font-size: 22px;
                  color: #333;
                  margin: 10px 0;
                  }
                  .thankyou-container p {
                  color: #666;
                  font-size: 16px;
                  margin-bottom: 20px;
                  }
                  .thankyou-container button {
                  background-color: #3498db;
                  color: white;
                  border: none;
                  padding: 10px 20px;
                  font-size: 16px;
                  border-radius: 5px;
                  cursor: pointer;
                  }
                  .thankyou-container button:hover {
                  background-color: #2980b9;
                  }


                  {% comment %} Recommneded products style {% endcomment %}
                  .recommended-products{
                  display: none;

                  }
                  #product-list{
                  display: flex;
                  gap: 40px;
                  flex-direction: row;
                  flex-wrap: wrap;
                  justify-content: center;
                  margin-bottom: 30px;
              }
              .product-item{
              display: flex;
              flex-direction: column;
              width: 20%;
              }
              .product-item img{
                  height: 220px;
                  object-fit: contain;
              }
              .quiz-product-title{
              font-size: 16px;
              color: black;
              font-weight: 500;
              text-align: left;
          }
          .quiz-product-desc{
              font-size: 16px;
              color: grey;
              font-weight:Normal;
          }
          .quiz-product-desc a{
              color: grey;
          }
          .substances-note{
              font-size: 16px;
              font-weight: 600;
              margin: 30px;
              text-align: center;
          }
          .quiz-ATC
          {
          background-color: #2DAE06
          }
          .product-item-link-inner{
            display: flex;
              flex-direction: column;
        }

          @media screen and (max-width: 980px){
            .product-item{

                width: 40%;
            }
          .inner-thankyou, .thankyou-container{
              margin-top: 20px;
              margin-bottom: 20px;
          }
          .thankyou-container
          {
              padding: 10px;
          }
          .quiz-container, .outer-form, .submit-section{
              width: 80%;
          }
          .submit-50-quest-note{
              max-width: 100%;
              font-size: 13px;
          }
          .question-label{
              font-size: 15px
          }
          .option-label{
              font-size: 15px;
          }
          }

          @media screen and (max-width: 767px){
          .quiz-container, .outer-form, .submit-section{
          width: 90%;
          }
          .quiz-container-heading{
          font-size: 14px;
          }
          .question-label, .option-label{
          font-size: 12px;
          padding:0  7px ;
          }
          .submit-50-quest-note{
          font-size: 12px;
          }
          .outer-form h2{
          font-size: 14px;
          margin-bottom: 10px;
          }
          .outer-form p{
          font-size: 10px;
          margin-bottom: 10px;
          }
          .inner-thankyou, .thankyou-container{
          margin-top: 10px;
          margin-bottom: 10px;
          }
          .thankyou-container .icon {
            font-size: 20px;
        }
        .inner-thankyou {
          margin-top: 20px !important;
          margin-bottom: 20px !important;
          }

          .inner-thankyou h2{
          font-size: 18px;
      }
      .inner-thankyou p{
        font-size: 14px;
        }
          }
    </style>
  </head>
  <body>
    {% assign questions = page.metafields.custom.questions.value %}

    <div class="quiz-form-main">
      <div class="outer-form">
        <h2>AFEGA® Vital-Check</h2>

        <p><strong>Notiz:</strong> Sie müssen mindestens 50 Fragen beantworten.</p>
      </div>
      <div class="quiz-container">
        <div class="quiz-container-heading-main">
          <h2 class="quiz-container-heading">
            Die Fragen müssen nicht in der hier angegebenen Reihenfolge beantwortet werden
          </h2>
        </div>
        <div id="questions-container"></div>

        <div class="navigation">
          <button id="prev-btn" onclick="prevPage()" disabled>Vorherige</button>
          <button id="next-btn" onclick="nextPage()">Nächste</button>
        </div>
      </div>
      <div class="submit-section">
        <button id="submit-btn" onclick="submitQuiz()" disabled>Senden Sie Ihr Formular</button>
        <p class="submit-50-quest-note">
          Nachdem Sie insgesamt 50 Fragen beantwortet haben, erhalten Sie die Möglichkeit, ein erstes Zwischenergebnis
          einzusehen. Anschließend können Sie nach der Beantwortung weiterer Fragen beobachten, wie sich die
          Empfehlungen verändern.
        </p>
      </div>
    </div>

    <div class="thankyou-container">
      <div class="inner-thankyou" style="max-width:578px; margin:auto;  margin-top: 50px ; margin-bottom: 50px">
        <div class="icon">✅</div>
        <h2>Danke</h2>
        <p>
          Ihr Formular wurde erfolgreich übermittelt. Basierend auf Ihren Antworten haben wir die Top-Empfehlungen für
          Sie ermittelt.
        </p>
        <button class="thankyou-button">Sehen Sie sich Ihre empfohlenen Ergebnisse an</button>
      </div>
    </div>

    <div class="recommended-products">
      <p class="substances-note"></p>
      <div id="product-list"></div>
    </div>

    <script>
               
              var questions = {{questions | json }}
             console.log("questions", questions)
              let currentPage = 0;
              let selectedAnswers = [];
              const requiredAnswers = 2;
        
              function renderQuestions() {
                const container = document.getElementById('questions-container');
                container.innerHTML = '';
        
                const startIndex = currentPage * 10;
                const endIndex = startIndex + 10;
        
                for (let i = startIndex; i < endIndex && i < questions.length; i++) {
                  const question = questions[i].question;
                  const questionDiv = document.createElement('div');
                  questionDiv.classList.add('question-item');
        
                  questionDiv.innerHTML = `
                <label class="question-label">Q-${i + 1}: ${question}</label>
                <div class="options">
                    <label class="option-label">
                        <input type="radio" name="q-${i}" value="3" ${Object.entries(questions[i]).map(([key, value]) => {
                            return `data-${key}="${3 * value}"`;
                        }).join(' ')} onchange="saveAnswer(${i}, 3)">
                        <span>✅ Ja</span>
                    </label>
                    <label class="option-label">
                        <input type="radio" name="q-${i}" value="2" ${Object.entries(questions[i]).map(([key, value]) => {
                            return `data-${key}="${2 * value}"`;
                        }).join(' ')}  onchange="saveAnswer(${i}, 2)">
                        <span>🤔 Manchmal / Vielleicht </span>
                    </label>
                    <label class="option-label">
                        <input type="radio" name="q-${i}" value="1" ${Object.entries(questions[i]).map(([key, value]) => {
                            return `data-${key}="${1 * value}"`;
                        }).join(' ')}  onchange="saveAnswer(${i}, 1)">
                        <span>❌ NEIN</span>
                    </label>
                </div>
                `;
                  container.appendChild(questionDiv);
                }
              }
        
              function saveAnswer(index, weight) {
                selectedAnswers[index] = weight;
                updateSubmitButton();
              }
        
              function updateSubmitButton() {
                const totalAnswered = selectedAnswers.filter((ans) => ans !== undefined).length;
                document.getElementById('submit-btn').disabled = totalAnswered < requiredAnswers;
              }
        
              function nextPage() {
                if ((currentPage + 1) * 10 < questions.length) {
                  currentPage++;
                  renderQuestions();
                  updateButtons();
                }
              }
        
              function prevPage() {
                if (currentPage > 0) {
                  currentPage--;
                  renderQuestions();
                  updateButtons();
                }
              }
        
              function updateButtons() {
                document.getElementById('prev-btn').disabled = currentPage === 0;
                document.getElementById('next-btn').disabled = (currentPage + 1) * 10 >= questions.length;
              }
        
              function submitQuiz() {
                let totalScores = {};
            
                // Loop through each question index
                for (let i = 0; i < questions.length; i++) {
                  // Get the checked radio input for question i
                  const checkedInput = document.querySelector(`input[name="q-${i}"]:checked`);
                  if (checkedInput) {
                    // For each data attribute on the selected radio, add its value to the total
                    for (const key in checkedInput.dataset) {
                      const value = parseFloat(checkedInput.dataset[key]) || 0;
                      if (!totalScores[key]) {
                        totalScores[key] = 0;
                      }
                      totalScores[key] += value;
                    }
                  }
                }
            
                // Sort substances by total score descending, then take the top 5
                const sortedSubstances = Object.entries(totalScores)
                  .sort((a, b) => b[1] - a[1])
                  .slice(0, 5);
            
                let resultMessage = 'Top 5 Recommended Substances:\n';
                sortedSubstances.forEach(([substance, score]) => {
                  resultMessage += `${substance}: ${score}\n`;
                });
            console.log("1st:" ,resultMessage)
    
                
            
                // Save top substances globally as lowercase for later comparison
                window.resultMessage = sortedSubstances.map(([substance]) => substance.toLowerCase().replace(/[^a-zA-Z0-9]/g, "_"));
                console.log("resultMessage" , resultMessage);
    
                // Preloaded products array via Liquid (see your existing code)
                var allProducts = [
                  {% for product in collections.all.products %}
                  {
                    title: "{{ product.title }}",
                    sku: "{{ product.variants.first.sku }}", 
                    url: "{{ product.url }}",
                    variant_id: "{{ product.variants.first.id }}",
           
                  short_desc:   '{{ product.metafields.custom.p_short_desc }}',
                    substances: "{{ product.metafields.custom.product_substances.value }}",
                    featured_image: "{{ product.featured_image | img_url: 'small' }}",
                    body_html: `{{ product.body_html | strip_newlines | escape }}`
                  }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ];
    
              
                console.log("All Products:", allProducts);
                var substancesSet = new Set();
    
                function addSubstance(substance) {
                    substancesSet.add(substance); // Add only unique values
                    let substancesString = Array.from(substancesSet).join(", "); // Convert set to a comma-separated string
                    return substancesString;
                }
                // Filter products based on matching substances (convert product substances to lowercase array)
                var matchingProducts = allProducts.filter(product => {
                  if (!product.substances || product.substances.trim() === "") return false;
                  
                  console.log("product.substances", product.substances);
                  let productSubstances = product.substances.split(",").map(s => s.trim().toLowerCase().replace(/[^a-zA-Z0-9]/g, "_"));
                  return window.resultMessage.some(substance => productSubstances.includes(substance));
                });
                matchingProducts.map(product => { addSubstance(product.substances) });
                console.log("Matching Products:", substancesSet);
                // Save matching products globally for later display
                window.matchingProducts = matchingProducts;
    
                console.log("real matched" ,  window.matchingProducts )
            
                window.substancesSet = substancesSet;
                // Hide quiz form and display thank-you container
                document.querySelector('.quiz-form-main').style.display = 'none';
                document.querySelector('.thankyou-container').style.display = 'block';
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                  });
              }
            
              renderQuestions();
            
              // When the user clicks the thank-you button, hide thank-you and show recommended-products
              document.querySelector('.thankyou-button').addEventListener('click', function() {
                // Hide thank-you container and show recommended-products container
                document.querySelector('.thankyou-container').style.display = 'none';
                document.querySelector('.recommended-products').style.display = 'block';
            
                // Update the note with top substances.
                const substancesNote = document.querySelector('.substances-note');
                substancesNote.innerText = 'Nachfolgend finden Sie die empfohlenen Produkte basierend auf den Top-Substanzen Ihres Quizergebnisses: ' +Array.from(window.substancesSet).join(", ");
            
                // Display the matching products in the product-list container.
                displayProducts(window.matchingProducts);
              });
            
              // Function to display matching products
              function displayProducts(products) {
                let productContainer = document.getElementById("product-list");
                productContainer.innerHTML = ""; // Clear previous results
            
                if (products.length === 0) {
                    productContainer.innerHTML = "<p>No matching products found.</p>";
                } else {
                    products.forEach(product => {
                        {% comment %} debugger {% endcomment %}
                        // Generate a unique ID for each product
                        const unique_id = product.variant_id; // or any unique identifier you prefer
                        let product_title =  product.title;
            console.log("product:hoor", product);
                        // Create a hidden div to hold the product data
                        let productHTML = `
                            <div class="product-item" data-variant-id="${unique_id}">
                            ${product_title}
                                {% render 'product-card-a',
                                    id: '${unique_id}',
                                    title: '${product_title}',
                                    image_sizes: 'small',
                                    prioritize_image: true,
                                    quick_shop_trigger: true,
                                    small_buttons_on_mobile: true,
                                    quick_shop_type: 'remote'
                                %}
                            </div>
                        `;
                        productContainer.innerHTML += productHTML;
                    });
                }
            
                attachAddToCartEvents();
            }
              function attachAddToCartEvents() {
                const addToCartButtons = document.querySelectorAll('.add-to-cart');
                addToCartButtons.forEach(btn => {
                  btn.addEventListener('click', function(e) {
                    const variantId = e.target.getAttribute('data-variant-id');
                    // Create the payload for adding to cart (quantity: 1 in this example)
              
                    fetch('/cart/add.js', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            id: variantId,
                            quantity: 1
    
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        console.log('Product added to cart:', data);
                    })
                });
                            
                    {% comment %} fetch('/cart/add.js', {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json'
                      },
                      body: JSON.stringify(payload)
                    })
                    .then(response => {
                      if (!response.ok) {
                        throw new Error('Network response was not ok');
                      }
                      return response.json();
                    })
                    .then(data => {
                      console.log("Product added to cart:", data);
                      // Optionally update your cart UI here
                    })
                    .catch(error => {
                      console.error("Error adding product to cart:", error);
                    }); {% endcomment %}
                  {% comment %} }); {% endcomment %}
                });
              }
    </script>
  </body>
</html>

{% schema %}
{
  "name": "Quiz Form",
  "settings": [
    {
      "type": "text",
      "id": "quiz_title",
      "label": "Quiz Title",
      "default": "Take Our Health Quiz"
    },
    {
      "type": "text",
      "id": "next_button_text",
      "label": "Next Button Text",
      "default": "Next"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield Namespace",
      "default": "custom"
    }
  ],
  "presets": [
    {
      "name": "Quiz Form"
    }
  ]
}
{% endschema %}
